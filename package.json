{
  "name": "ybrain",
  "version": "0.1.0",
  "description": "Company knowledge MCP server — prompts, ownership, docs, long-term memory, and authoring, backed by a single Git data repo",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ybrain": "src/server.ts"
  },
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch run src/server.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.0",
    "gray-matter": "^4.0.3",
    "simple-git": "^3.27.0",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
