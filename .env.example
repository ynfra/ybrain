# ── ybrain server configuration ───────────────────────────────────────────────

# HTTP port the MCP server listens on (Streamable HTTP at POST /mcp).
YBRAIN_PORT=8080

# ── Data repo (the single Git repo ybrain reads and writes) ───────────────────
# Clone URL. HTTPS with a token is simplest for a hosted service; SSH also works
# if the container has the key mounted. Example HTTPS form:
#   https://x-access-token:${YBRAIN_GIT_TOKEN}@github.com/<acct>/<repo>.git
YBRAIN_DATA_REPO_URL=https://github.com/your-acct/ybrain-data.git
YBRAIN_DATA_BRANCH=main

# Personal access token / deploy token of the ONE service account that authors
# every commit. Needs push access to the data repo. Injected into the HTTPS
# remote at runtime — keep it out of the URL you commit.
YBRAIN_GIT_TOKEN=

# Local path where the data repo is cloned. Mount a persistent volume here so
# restarts sync instead of re-cloning.
YBRAIN_DATA_DIR=/data/repo

# Committer e-mail for the service account (author name comes from the
# supervisor token that published, or the "suggestion" label for drafts).
YBRAIN_GIT_AUTHOR_EMAIL=ybrain@example.com

# Background refresh interval in seconds (fetch + hard-reset to remote; picks up
# edits made via GitHub UI / merges). 0 disables it.
YBRAIN_PULL_INTERVAL=180

# ── Access tiers ──────────────────────────────────────────────────────────────
# Reads and suggest_* are OPEN (no token). Only the supervisor tier
# (publish_draft / reject_draft / add_skill_source) needs a token.
# Format: name=token pairs, comma-separated. The name authors published commits
# and lets you revoke one supervisor without rotating the rest.
# Empty ⇒ nobody can publish via MCP (supervisors manage drafts in Git instead).
YBRAIN_SUPERVISOR_TOKENS=

# Abuse limits (suggestions are open): max request body bytes and per-IP req/min.
YBRAIN_MAX_BODY_BYTES=1000000
YBRAIN_RATE_LIMIT_PER_MIN=120

# Timeout (ms) for individual git operations, so a hung network op can't wedge
# the write queue.
YBRAIN_GIT_TIMEOUT_MS=20000

# Optional secret for the GitHub push webhook (POST /webhook). When set, the
# endpoint verifies X-Hub-Signature-256 (HMAC-SHA256 of the body) and triggers a
# refresh. Leave empty to disable the endpoint entirely.
YBRAIN_WEBHOOK_SECRET=
